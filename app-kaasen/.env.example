# Copy to .env.local. The frontend runs WITHOUT any of these (all have defaults).

# Public site URL (canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.medizintechnik-kaasen.de

# Nextcloud upload page users are redirected to after the prescription form
NEXT_PUBLIC_NEXTCLOUD_UPLOAD_URL=https://nextcloud.kaasen.de/index.php/s/n6CBiiSMew9knW4

# Phase 2: base URL of the backend API (see docs/BACKEND.md). Unused while lib/api is mocked.
NEXT_PUBLIC_API_BASE_URL=
